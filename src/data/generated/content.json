        {
          "id": "SHL.SB.TYS.002",
          "no": 2,
          "text": "太阳病，发热，汗出，恶风，脉缓者，名为中风。",
          "translation": "太阳病见到发热、汗出、怕风、脉象缓的，称为中风。",
          "annotations": [
            {
              "source": "示例注本（待校对）",
              "author": "示例注家",
              "text": "此条为太阳中风提纲，以发热、汗出、恶风、脉缓为辨证要点。"
            }
          ],
          "formulas": [],
          "symptomTags": [
            "SHL.SB.SYM.001",
